<TICKET_DATA NAME="ORIGINDEST"         ROW="2" COL="43" MAX="0"  RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="SELLFLAG"           ROW="2" COL="50"  MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="PASSENGERNAME"      ROW="4" COL="3"  MAX="30" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="DATAOFISSUE"        ROW="3" COL="34"  MAX="0"  RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="EI"                 ROW="2" COL="3"  MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="BOOKINGREF"         ROW="3" COL="43" MAX="0"  RECURRENCY="1"></TICKET_DATA>
