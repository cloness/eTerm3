<TICKET_DATA NAME="TAX3"        ROW="16" COL="1"  MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="TOTALFARE"   ROW="17" COL="1"  MAX="0" RECURRENCY="1"></TICKET_DATA>

<TICKET_DATA NAME="CURRENCY"        ROW="20" COL="45"  MAX="0" RECURRENCY="0"></TICKET_DATA>
