<TICKET_DATA NAME="COMMISION"       ROW="20" COL="70"  MAX="0" RECURRENCY="0"></TICKET_DATA>
<TICKET_DATA NAME="TAXAMOUNT"       ROW="20" COL="75"  MAX="0" RECURRENCY="0"></TICKET_DATA>

<!-- 其他 -->
<TICKET_DATA NAME="CONTROLNO"   ROW="19" COL="3"  MAX="4" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="OILTAX"      ROW="14" COL="64" MAX="0" RECURRENCY="0"></TICKET_DATA>
<TICKET_DATA NAME="TC"          ROW="4"  COL="30" MAX="30" RECURRENCY="1"></TICKET_DATA>
</TICKET_FORMAT>







