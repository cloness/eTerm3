<TICKET_FORMAT>
<TICKET_TYPE>
东航国际本票
</TICKET_TYPE>
<ROWS>25</ROWS>
<COLUMNS>80</COLUMNS>
<ENGLISH>YES</ENGLISH>


<!-- 机票联数：目前可能值：2联或4联 -->
<SEGMENTS>4</SEGMENTS>
<SEGMENTHEIGHT>1</SEGMENTHEIGHT>

<!-- 机票左上角信息 -->
<TICKET_DATA NAME="ISSUEDBY"           ROW="0" COL="0"   MAX="20" RECURRENCY="0"></TICKET_DATA>
<TICKET_DATA NAME="CONJUNCTIONTICKETS" ROW="5" COL="25"  MAX="20" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="ORIGINDEST"         ROW="1" COL="50"  MAX="0"  RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="SELLFLAG"           ROW="1" COL="45"  MAX="0"  RECURRENCY="0"></TICKET_DATA>
<TICKET_DATA NAME="PASSENGERNAME"      ROW="5" COL="1"   MAX="28" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="EI"                 ROW="3" COL="1"   MAX="28" RECURRENCY="2"></TICKET_DATA>
<TICKET_DATA NAME="BOOKINGREF"         ROW="2" COL="50"  MAX="0"  RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="EXCHANGEFOR"        ROW="3" COL="45"  MAX="5"  RECURRENCY="1"></TICKET_DATA>


<!-- 机票右上角信息 -->
<TICKET_DATA NAME="IATA"        ROW="1" COL="59" MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="DATAOFISSUE" ROW="1" COL="67" MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="ISSUEPLACE"  ROW="2" COL="59" MAX="0" RECURRENCY="1"></TICKET_DATA>
