<TICKET_DATA NAME="CLASS"     ROW="7" COL="29" MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="DATE"      ROW="7" COL="31" MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="TIME"      ROW="7" COL="37" MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="STATUS"    ROW="7" COL="42" MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="FAREBASIS" ROW="7" COL="45" MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="BEFORE"    ROW="7" COL="60" MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="AFTER"     ROW="7" COL="65" MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="ALLOW"     ROW="7" COL="70" MAX="4" RECURRENCY="1"></TICKET_DATA>

