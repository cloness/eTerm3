<TICKET_DATA NAME="DEVICE"      ROW="4" COL="59" MAX="0" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="AGENT"       ROW="5" COL="69" MAX="0" RECURRENCY="1"></TICKET_DATA>

<!-- 航段信息 -->
<TICKET_DATA NAME="XO"        ROW="7" COL="2"  MAX="1" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="CITYNAME"  ROW="7" COL="3"  MAX="13" RECURRENCY="1"></TICKET_DATA>
<TICKET_DATA NAME="CITYCODE"  ROW="7" COL="16" MAX="3" RECURRENCY="1"></TICKET_DATA>
